        target_content: "      {/* Hero Section */}\n      <section className=\"relative py-16 md:py-20 px-4 md:px-12 max-w-7xl mx-auto border-b border-[#dbc2b0] dot-pattern\">\n        <div className=\"max-w-3xl\">\n          <h1 className=\"text-3xl md:text-5xl font-extrabold font-headline text-[#914d00] mb-6 tracking-tight\">\n            Building Kenya\'s Future.\n          </h1>\n          <p className=\"text-lg text-[#554336] leading-relaxed\">\n            From commercial high-rises to luxury residential developments, FundiPro Hardware supplies the robust, KEBS-certified materials that power professional construction. Explore our featured projects and capabilities.\n          </p>\n        </div>\n      </section>\n\n      {/* Featured Case Study Section */}\n      <section className=\"py-12 md:py-20 px-4 md:px-12 max-w-7xl mx-auto\">\n        <div className=\"flex items-center gap-4 mb-8\">\n          <span className=\"h-0.5 bg-[#914d00] w-12 block\" />\n          <h2 className=\"text-xl md:text-2xl font-bold font-headline text-[#914d00]\">\n            Featured Case Study\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 border border-[#dbc2b0] bg-white rounded-lg overflow-hidden shadow-xs\">\n          {/* Image Column */}\n          <div className=\"md:col-span-7 h-72 md:h-auto min-h-[380px] relative border-b md:border-b-0 md:border-r border-[#dbc2b0]\">\n            <img\n              src={featuredCaseStudy.imageUrl}\n              alt={featuredCaseStudy.title}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          {/* Details Column */}\n          <div className=\"md:col-span-5 p-6 md:p-10 flex flex-col justify-center\">\n            <div className=\"inline-block bg-[#e8e8e8] px-3 py-1 mb-4 border border-[#dbc2b0] text-xs font-bold text-[#1a1c1c] w-max\">\n              {featuredCaseStudy.year}\n            </div>\n\n            <h3 className=\"text-2xl md:text-3xl font-bold font-headline text-[#914d00] mb-4\">\n              {featuredCaseStudy.title}\n            </h3>\n\n            <p className=\"text-sm text-[#554336] mb-8 leading-relaxed\">\n              {featuredCaseStudy.description}\n            </p>\n\n            {/* Project Spec Table */}\n            <ul className=\"flex flex-col border border-[#dbc2b0] rounded overflow-hidden text-xs\">\n              <li className=\"flex justify-between p-3 bg-white border-b border-[#dbc2b0]\">\n                <span className=\"text-[#554336]\">Scope</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.scope}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-[#f3f3f3] border-b border-[#dbc2b0]\">\n                <span className=\"text-[#554336]\">Scale</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.scale}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-white\">\n                <span className=\"text-[#554336]\">Compliance</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.compliance}\n                </span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* Supply Highlights Grid */}\n      <section className=\"py-16 bg-[#f3f3f3] border-y border-[#dbc2b0]\">\n        <div className=\"px-4 md:px-12 max-w-7xl mx-auto\">\n          <h2 className=\"text-xl md:text-2xl font-bold font-headline text-[#914d00] mb-10\">\n            Supply Highlights\n          </h2>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {supplyHighlights.map((item) => (\n              <div\n                key={item.id}\n                className=\"border border-[#dbc2b0] bg-white rounded-lg overflow-hidden group shadow-xs hover:shadow-md transition-shadow\"\n              >\n                <div className=\"h-56 w-full border-b border-[#dbc2b0] relative overflow-hidden\">\n                  <img\n                    src={item.imageUrl}\n                    alt={item.title}\n                    className=\"w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500\"\n                  />\n                </div>\n                <div className=\"p-6\">\n                  <h4 className=\"text-lg font-bold font-headline text-[#1a1c1c] mb-2\">\n                    {item.title}\n                  </h4>\n                  <p className=\"text-xs text-[#554336] leading-relaxed\">\n                    {item.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* CTA Box */}\n      <section className=\"py-20 px-4 md:px-12 bg-[#f9f9f9] dot-pattern\">\n        <div className=\"max-w-4xl mx-auto text-center border-4 border-[#914d00] p-8 md:p-14 bg-white shadow-md rounded-lg\">\n          <h2 className=\"text-2xl md:text-3xl font-extrabold font-headline text-[#914d00] mb-4\">\n            Ready to provision your next project?\n          </h2>\n          <p className=\"text-sm md:text-base text-[#554336] mb-8 max-w-2xl mx-auto leading-relaxed\">\n            Partner with FundiPro for reliable, bulk supply of certified hardware materials. We offer dedicated account managers for large-scale developments.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-4 justify-center items-center\">\n            <button\n              onClick={onRequestQuote}\n              className=\"bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-3.5 px-8 border border-[#f28c28] transition-colors w-full sm:w-auto uppercase tracking-wider text-xs rounded shadow-xs\"\n            >\n              Get a Bulk Quote\n            </button>\n            <button\n        