      target_content: "        {/* Sidebar Filters */}\n        <aside className=\"md:col-span-3 space-y-6\">\n          <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-5 shadow-xs\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-[#1a1c1c] mb-4 pb-2 border-b border-[#dbc2b0]\">\n              Filter Products\n            </h3>\n\n            {/* Category Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">Category</h4>\n              <div className=\"space-y-2\">\n                {categoriesList.map((cat) => (\n                  <label\n                    key={cat.name}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.categories.includes(cat.name)}\n                      onChange={() => toggleCategory(cat.name)}\n                      className=\"rounded text-[#914d00] focus:ring-[#914d00] h-4 w-4 border-[#887364]\"\n                    />\n                    <span className=\"text-[#554336] group-hover:text-[#914d00] transition-colors\">\n                      {cat.name} ({cat.count})\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Brand Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">Brands</h4>\n              <div className=\"space-y-2\">\n                {brandsList.map((brand) => (\n                  <label\n                    key={brand}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.brands.includes(brand)}\n                      onChange={() => toggleBrand(brand)}\n                      className=\"rounded text-[#914d00] focus:ring-[#914d00] h-4 w-4 border-[#887364]\"\n                    />\n                    <span className=\"text-[#554336] group-hover:text-[#914d00] transition-colors\">\n                      {brand}\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Price Filter */}\n            <div>\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">\n                Price Range (KSh)\n              </h4>\n              <form onSubmit={handlePriceApply} className=\"space-y-3\">\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    value={filters.minPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, minPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-[#887364] rounded px-2.5 py-1.5 text-xs bg-white text-[#1a1c1c] focus:outline-none focus:border-[#914d00]\"\n                  />\n                  <span className=\"text-gray-500\">-</span>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    value={filters.maxPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, maxPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-[#887364] rounded px-2.5 py-1.5 text-xs bg-white text-[#1a1c1c] focus:outline-none focus:border-[#914d00]\"\n                  />\n                </div>\n                <button\n                  type=\"submit\"\n                  className=\"w-full border border-[#1a1c1c] text-[#1a1c1c] font-bold py-2 rounded text-xs hover:bg-[#e4e2e1] transition-colors\"\n                >\n                  Apply Filter\n                </button>\n              </form>\n            </div>\n          </div>\n\n          {/* Bulk Quote CTA Banner */}\n          <div className=\"bg-[#5d2f00] text-white rounded-lg p-5 border border-[#f28c28]/40 space-y-3\">\n            <h4 className=\"font-bold text-sm text-[#ffdcc3]\">Bulk Contractor Orders</h4>\n            <p className=\"text-xs opacity-90 leading-relaxed\">\n              Ordering for a major building site? Request customized volume quotes with site delivery options across Kenya.\n            </p>\n            <button\n              onClick={onRequestQuote}\n              className=\"w-full bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-2 px-3 rounded text-xs transition-colors\"\n            >\n              Request Bulk Quote\n            </button>\n          </div>\n        </aside>"
      replacement_content: "        {/* Sidebar Filters */}\n        <aside className=\"md:col-span-3 space-y-6\">\n          <div className=\"bg-white/80 border border-black/10 p-5\">\n            <h3 className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#1A1A1A] mb-4 pb-2 border-b border-black/10 flex justify-between items-center\">\n              <span>Filter Index</span>\n              <span className=\"text-black/40\">CATALOGUE</span>\n            </h3>\n\n            {/* Category Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-xs font-bold uppercase tracking-wider mb-3 text-[#1A1A1A]\">Category</h4>\n              <div className=\"space-y-2\">\n                {categoriesList.map((cat) => (\n                  <label\n                    key={cat.name}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.categories.includes(cat.name)}\n                      onChange={() => toggleCategory(cat.name)}\n                      className=\"rounded-none text-[#1A1A1A] focus:ring-[#1A1A1A] h-3.5 w-3.5 border-black/30\"\n                    />\n                    <span className=\"text-black/70 group-hover:text-[#b45309] transition-colors\">\n                      {cat.name} <span className=\"text-black/40 text-[10px]\">({cat.count})</span>\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Brand Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-xs font-bold uppercase tracking-wider mb-3 text-[#1A1A1A]\">Brands</h4>\n              <div className=\"space-y-2\">\n                {brandsList.map((brand) => (\n                  <label\n                    key={brand}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.brands.includes(brand)}\n                      onChange={() => toggleBrand(brand)}\n                      className=\"rounded-none text-[#1A1A1A] focus:ring-[#1A1A1A] h-3.5 w-3.5 border-black/30\"\n                    />\n                    <span className=\"text-black/70 group-hover:text-[#b45309] transition-colors\">\n                      {brand}\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Price Filter */}\n            <div>\n              <h4 className=\"text-xs font-bold uppercase tracking-wider mb-3 text-[#1A1A1A]\">\n                Price Range (KSh)\n              </h4>\n              <form onSubmit={handlePriceApply} className=\"space-y-3\">\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    value={filters.minPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, minPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-black/15 rounded-none px-2.5 py-1.5 text-xs bg-white text-[#1A1A1A] focus:outline-none focus:border-black\"\n                  />\n                  <span className=\"text-black/30\">-</span>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    value={filters.maxPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, maxPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-black/15 rounded-none px-2.5 py-1.5 text-xs bg-white text-[#1A1A1A] focus:outline-none focus:border-black\"\n                  />\n                </div>\n                <button\n                  type=\"submit\"\n                  className=\"w-full bg-[#1A1A1A] text-white font-bold text-[10px] tracking-[0.2em] uppercase py-2 hover:bg-[#b45309] transition-colors\"\n                >\n                  Apply Filter\n                </button>\n              </form>\n            </div>\n          </div>\n\n          {/* Bulk Quote CTA Banner */}\n          <div className=\"bg-[#1A1A1A] text-white p-5 border border-black/20 space-y-3\">\n            <div className=\"text-[9px] tracking-[0.25em] font-bold uppercase text-[#b45309]\">CONTRACTOR DIRECT</div>\n            <h4 className=\"font-serif text-base font-bold text-white tracking-tight\">Bulk Construction Inquiries</h4>\n            <p className=\"text-xs text-white/70 leading-relaxed font-sans\">\n              Ordering for major building sites? Request customized volume pricing with site delivery options across Kenya.\n            </p>\n            <button\n              onClick={onRequestQuote}\n              className=\"w-full bg-[#b45309] hover:bg-[#d97706] text-white font-bold text-[10px] tracking-[0.2em] uppercase py-2.5 px-3 transition-colors\"\n            >\n              Request Bulk Quote\n            </button>\n          </div>\n        </aside>"
