  file_change {
    absolute_path_uri: "file:///src/views/PortfolioView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* Hero Section */}\n      <section className=\"relative py-16 md:py-20 px-4 md:px-12 max-w-7xl mx-auto border-b border-[#dbc2b0] dot-pattern\">\n        <div className=\"max-w-3xl\">\n          <h1 className=\"text-3xl md:text-5xl font-extrabold font-headline text-[#914d00] mb-6 tracking-tight\">\n            Building Kenya\'s Future.\n          </h1>\n          <p className=\"text-lg text-[#554336] leading-relaxed\">\n            From commercial high-rises to luxury residential developments, FundiPro Hardware supplies the robust, KEBS-certified materials that power professional construction. Explore our featured projects and capabilities.\n          </p>\n        </div>\n      </section>\n\n      {/* Featured Case Study Section */}\n      <section className=\"py-12 md:py-20 px-4 md:px-12 max-w-7xl mx-auto\">\n        <div className=\"flex items-center gap-4 mb-8\">\n          <span className=\"h-0.5 bg-[#914d00] w-12 block\" />\n          <h2 className=\"text-xl md:text-2xl font-bold font-headline text-[#914d00]\">\n            Featured Case Study\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 border border-[#dbc2b0] bg-white rounded-lg overflow-hidden shadow-xs\">\n          {/* Image Column */}\n          <div className=\"md:col-span-7 h-72 md:h-auto min-h-[380px] relative border-b md:border-b-0 md:border-r border-[#dbc2b0]\">\n            <img\n              src={featuredCaseStudy.imageUrl}\n              alt={featuredCaseStudy.title}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          {/* Details Column */}\n          <div className=\"md:col-span-5 p-6 md:p-10 flex flex-col justify-center\">\n            <div className=\"inline-block bg-[#e8e8e8] px-3 py-1 mb-4 border border-[#dbc2b0] text-xs font-bold text-[#1a1c1c] w-max\">\n              {featuredCaseStudy.year}\n            </div>\n\n            <h3 className=\"text-2xl md:text-3xl font-bold font-headline text-[#914d00] mb-4\">\n              {featuredCaseStudy.title}\n            </h3>\n\n            <p className=\"text-sm text-[#554336] mb-8 leading-relaxed\">\n              {featuredCaseStudy.description}\n            </p>\n\n            {/* Project Spec Table */}\n            <ul className=\"flex flex-col border border-[#dbc2b0] rounded overflow-hidden text-xs\">\n              <li className=\"flex justify-between p-3 bg-white border-b border-[#dbc2b0]\">\n                <span className=\"text-[#554336]\">Scope</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.scope}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-[#f3f3f3] border-b border-[#dbc2b0]\">\n                <span className=\"text-[#554336]\">Scale</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.scale}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-white\">\n                <span className=\"text-[#554336]\">Compliance</span>\n                <span className=\"text-[#914d00] font-bold\">\n                  {featuredCaseStudy.compliance}\n                </span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* Supply Highlights Grid */}\n      <section className=\"py-16 bg-[#f3f3f3] border-y border-[#dbc2b0]\">\n        <div className=\"px-4 md:px-12 max-w-7xl mx-auto\">\n          <h2 className=\"text-xl md:text-2xl font-bold font-headline text-[#914d00] mb-10\">\n            Supply Highlights\n          </h2>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {supplyHighlights.map((item) => (\n              <div\n                key={item.id}\n                className=\"border border-[#dbc2b0] bg-white rounded-lg overflow-hidden group shadow-xs hover:shadow-md transition-shadow\"\n              >\n                <div className=\"h-56 w-full border-b border-[#dbc2b0] relative overflow-hidden\">\n                  <img\n                    src={item.imageUrl}\n                    alt={item.title}\n                    className=\"w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500\"\n                  />\n                </div>\n                <div className=\"p-6\">\n                  <h4 className=\"text-lg font-bold font-headline text-[#1a1c1c] mb-2\">\n                    {item.title}\n                  </h4>\n                  <p className=\"text-xs text-[#554336] leading-relaxed\">\n                    {item.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* CTA Box */}\n      <section className=\"py-20 px-4 md:px-12 bg-[#f9f9f9] dot-pattern\">\n        <div className=\"max-w-4xl mx-auto text-center border-4 border-[#914d00] p-8 md:p-14 bg-white shadow-md rounded-lg\">\n          <h2 className=\"text-2xl md:text-3xl font-extrabold font-headline text-[#914d00] mb-4\">\n            Ready to provision your next project?\n          </h2>\n          <p className=\"text-sm md:text-base text-[#554336] mb-8 max-w-2xl mx-auto leading-relaxed\">\n            Partner with FundiPro for reliable, bulk supply of certified hardware materials. We offer dedicated account managers for large-scale developments.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-4 justify-center items-center\">\n            <button\n              onClick={onRequestQuote}\n              className=\"bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-3.5 px-8 border border-[#f28c28] transition-colors w-full sm:w-auto uppercase tracking-wider text-xs rounded shadow-xs\"\n            >\n              Get a Bulk Quote\n            </button>\n            <button\n              onClick={openWhatsApp}\n              className=\"bg-transparent text-[#914d00] font-bold py-3.5 px-8 border border-[#914d00] hover:bg-[#e8e8e8] transition-colors w-full sm:w-auto flex items-center justify-center gap-2 uppercase tracking-wider text-xs rounded\"\n            >\n              <span className=\"material-symbols-outlined text-base\">chat</span>\n              WhatsApp Us\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Bottom Trust Indicators Bar */}\n      <div className=\"bg-[#e8e8e8] border-t border-[#dbc2b0] py-4 px-4 text-center text-xs font-bold text-[#554336] flex flex-wrap justify-center gap-6 md:gap-12\">\n        <span className=\"flex items-center gap-1.5\">\n          <span className=\"material-symbols-outlined text-[#914d00] text-lg\">verified</span>\n          KEBS Certified Products\n        </span>\n        <span className=\"flex items-center gap-1.5\">\n          <span className=\"material-symbols-outlined text-[#914d00] text-lg\">receipt_long</span>\n          KRA Compliant Invoicing\n        </span>\n        <span className=\"flex items-center gap-1.5\">\n          <span className=\"material-symbols-outlined text-[#914d00] text-lg\">shield</span>\n          Genuine Brands Guarantee\n        </span>\n      </div>"
      replacement_content: "      {/* Hero Section */}\n      <section className=\"relative py-16 md:py-20 px-4 md:px-12 max-w-7xl mx-auto border-b border-black/15 dot-pattern\">\n        <div className=\"max-w-3xl\">\n          <span className=\"text-[10px] tracking-[0.25em] font-bold uppercase text-[#b45309] block mb-2\">ARCHITECTURAL PROVISIONING</span>\n          <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-[#1A1A1A] mb-6 tracking-tight italic\">\n            Building Kenya\'s Infrastructure.\n          </h1>\n          <p className=\"text-base text-black/70 leading-relaxed font-sans\">\n            From commercial high-rises to luxury residential developments, FundiPro Hardware supplies the robust, KEBS-certified materials that power professional construction.\n          </p>\n        </div>\n      </section>\n\n      {/* Featured Case Study Section */}\n      <section className=\"py-12 md:py-20 px-4 md:px-12 max-w-7xl mx-auto\">\n        <div className=\"flex items-center gap-3 mb-8\">\n          <span className=\"h-[2px] bg-[#b45309] w-10 block\" />\n          <h2 className=\"text-xs font-bold uppercase tracking-[0.25em] text-[#1A1A1A]\">\n            FEATURED CASE STUDY\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 border border-black/15 bg-white overflow-hidden\">\n          {/* Image Column */}\n          <div className=\"md:col-span-7 h-72 md:h-auto min-h-[380px] relative border-b md:border-b-0 md:border-r border-black/15\">\n            <img\n              src={featuredCaseStudy.imageUrl}\n              alt={featuredCaseStudy.title}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          {/* Details Column */}\n          <div className=\"md:col-span-5 p-6 md:p-10 flex flex-col justify-center\">\n            <div className=\"inline-block bg-[#1A1A1A] px-3 py-1 mb-4 text-[10px] font-bold tracking-[0.2em] uppercase text-white w-max\">\n              {featuredCaseStudy.year}\n            </div>\n\n            <h3 className=\"text-2xl md:text-3xl font-serif font-bold text-[#1A1A1A] mb-4 tracking-tight\">\n              {featuredCaseStudy.title}\n            </h3>\n\n            <p className=\"text-xs text-black/70 mb-8 leading-relaxed font-sans\">\n              {featuredCaseStudy.description}\n            </p>\n\n            {/* Project Spec Table */}\n            <ul className=\"flex flex-col border border-black/10 overflow-hidden text-xs\">\n              <li className=\"flex justify-between p-3 bg-white border-b border-black/10\">\n                <span className=\"text-black/50\">Scope</span>\n                <span className=\"text-[#1A1A1A] font-bold\">\n                  {featuredCaseStudy.scope}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-[#EFECE6] border-b border-black/10\">\n                <span className=\"text-black/50\">Scale</span>\n                <span className=\"text-[#1A1A1A] font-bold\">\n                  {featuredCaseStudy.scale}\n                </span>\n              </li>\n              <li className=\"flex justify-between p-3 bg-white\">\n                <span className=\"text-black/50\">Compliance</span>\n                <span className=\"text-[#b45309] font-bold\">\n                  {featuredCaseStudy.compliance}\n                </span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* Supply Highlights Grid */}\n      <section className=\"py-16 bg-[#EFECE6] border-y border-black/10\">\n        <div className=\"px-4 md:px-12 max-w-7xl mx-auto\">\n          <div className=\"flex justify-between items-center mb-10 pb-3 border-b border-black/10\">\n            <h2 className=\"text-lg md:text-xl font-serif font-bold text-[#1A1A1A] tracking-tight\">\n              Supply Capabilities\n            </h2>\n            <span className=\"text-[10px] tracking-[0.25em] font-bold uppercase text-black/40\">PROJECT ARCHIVE</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {supplyHighlights.map((item) => (\n              <div\n                key={item.id}\n                className=\"border border-black/10 bg-white overflow-hidden group hover:border-black transition-colors\"\n              >\n                <div className=\"h-56 w-full border-b border-black/10 relative overflow-hidden bg-[#F5F2ED]\">\n                  <img\n                    src={item.imageUrl}\n                    alt={item.title}\n                    className=\"w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500\"\n                  />\n                </div>\n                <div className=\"p-6\">\n                  <h4 className=\"text-base font-bold text-[#1A1A1A] mb-2 tracking-tight group-hover:text-[#b45309] transition-colors\">\n                    {item.title}\n                  </h4>\n                  <p className=\"text-xs text-black/60 leading-relaxed font-sans\">\n                    {item.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* CTA Box */}\n      <section className=\"py-20 px-4 md:px-12 bg-[#F5F2ED] dot-pattern\">\n        <div className=\"max-w-4xl mx-auto text-center border-2 border-black/20 p-8 md:p-14 bg-white shadow-xs\">\n          <span className=\"text-[10px] tracking-[0.25em] font-bold uppercase text-[#b45309] block mb-2\">BULK SUPPLY DIRECT</span>\n          <h2 className=\"text-2xl md:text-3xl font-serif font-bold text-[#1A1A1A] mb-4 tracking-tight\">\n            Ready to provision your next project?\n          </h2>\n          <p className=\"text-xs md:text-sm text-black/70 mb-8 max-w-2xl mx-auto leading-relaxed font-sans\">\n            Partner with FundiPro for reliable, bulk supply of certified hardware materials with dedicated account managers.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-4 justify-center items-center\">\n            <button\n              onClick={onRequestQuote}\n              className=\"bg-[#1A1A1A] hover:bg-[#b45309] text-white font-bold py-3.5 px-8 transition-colors w-full sm:w-auto uppercase tracking-[0.2em] text-[10px]\"\n            >\n              Get a Bulk Quote\n            </button>\n            <button\n              onClick={openWhatsApp}\n              className=\"bg-transparent text-[#1A1A1A] font-bold py-3.5 px-8 border border-black/20 hover:bg-black/5 transition-colors w-full sm:w-auto flex items-center justify-center gap-2 uppercase tracking-[0.2em] text-[10px]\"\n            >\n              <span className=\"material-symbols-outlined text-base\">chat</span>\n              WhatsApp Us\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Bottom Trust Indicators Bar */}\n      <div className=\"bg-[#EFECE6] border-t border-black/10 py-4 px-4 text-center text-xs font-bold text-[#1A1A1A] flex flex-wrap justify-center gap-6 md:gap-12 uppercase tracking-[0.15em]\">\n        <span className=\"flex items-center gap-1.5 text-[10px]\">\n          <span className=\"material-symbols-outlined text-[#b45309] text-base\">verified</span>\n          KEBS Certified Products\n        </span>\n        <span className=\"flex items-center gap-1.5 text-[10px]\">\n          <span className=\"material-symbols-outlined text-[#b45309] text-base\">receipt_long</span>\n          KRA Compliant Invoicing\n        </span>\n        <span className=\"flex items-center gap-1.5 text-[10px]\">\n          <span className=\"material-symbols-outlined text-[#b45309] text-base\">shield</span>\n          Genuine Brands Guarantee\n        </span>\n      </div>"
    }
