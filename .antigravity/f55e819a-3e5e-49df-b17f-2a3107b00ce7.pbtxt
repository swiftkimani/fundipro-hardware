  file_change {
    absolute_path_uri: "file:///src/components/CartDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { CartItem } from \'../types\';\n\ninterface CartDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  cartItems: CartItem[];\n  onUpdateQuantity: (productId: string, quantity: number) => void;\n  onRemoveItem: (productId: string) => void;\n  onClearCart: () => void;\n}\n\nexport const CartDrawer: React.FC<CartDrawerProps> = ({\n  isOpen,\n  onClose,\n  cartItems,\n  onUpdateQuantity,\n  onRemoveItem,\n  onClearCart,\n}) => {\n  const [showMpesaModal, setShowMpesaModal] = useState(false);\n  const [phoneNumber, setPhoneNumber] = useState(\'\');\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [mpesaSuccess, setMpesaSuccess] = useState(false);\n\n  if (!isOpen) return null;\n\n  const totalKsh = cartItems.reduce(\n    (sum, item) => sum + item.product.price * item.quantity,\n    0\n  );\n\n  const formatKsh = (num: number) => `KSh ${num.toLocaleString()}`;\n\n  const generateWhatsAppOrder = () => {\n    let text = `Hello FundiPro Hardware! I would like to place an order:\\n\\n`;\n    cartItems.forEach((item, index) => {\n      text += `${index + 1}. ${item.product.title} (x${item.quantity}) - KSh ${(item.product.price * item.quantity).toLocaleString()}\\n`;\n    });\n    text += `\\n*Total:* KSh ${totalKsh.toLocaleString()}\\n`;\n    text += `\\nPlease confirm stock availability and site delivery options. Thank you!`;\n\n    const encoded = encodeURIComponent(text);\n    window.open(`https://wa.me/254700123456?text=${encoded}`, \'_blank\');\n  };\n\n  const handleMpesaSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!phoneNumber) return;\n    setIsProcessing(true);\n\n    setTimeout(() => {\n      setIsProcessing(false);\n      setMpesaSuccess(true);\n      setTimeout(() => {\n        setMpesaSuccess(false);\n        setShowMpesaModal(false);\n        onClearCart();\n        onClose();\n      }, 2500);\n    }, 2000);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-[70] flex justify-end\">\n      <div\n        className=\"fixed inset-0 bg-black/50 transition-opacity\"\n        onClick={onClose}\n      />\n\n      <div className=\"relative w-full max-w-md bg-white h-full shadow-2xl flex flex-col z-10\">\n        {/* Cart Header */}\n        <div className=\"p-5 border-b border-[#dbc2b0] flex justify-between items-center bg-[#f9f9f9]\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#914d00]\">shopping_cart</span>\n            <h2 className=\"text-lg font-bold font-headline text-[#1a1c1c]\">\n              Your Shopping Cart ({cartItems.reduce((acc, i) => acc + i.quantity, 0)})\n            </h2>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-md text-[#554336] hover:bg-gray-200 transition-colors\"\n          >\n            <span className=\"material-symbols-outlined\">close</span>\n          </button>\n        </div>\n\n        {/* Cart Items List */}\n        <div className=\"flex-1 overflow-y-auto p-5 space-y-4\">\n          {cartItems.length === 0 ? (\n            <div className=\"text-center py-12 text-[#554336]\">\n              <span className=\"material-symbols-outlined text-5xl mb-2 text-gray-300\">\n                remove_shopping_cart\n              </span>\n              <p className=\"font-semibold\">Your cart is empty</p>\n              <p className=\"text-xs text-gray-500 mt-1\">\n                Browse our hardware deals and add materials or tools to your order.\n              </p>\n            </div>\n          ) : (\n            cartItems.map((item) => (\n              <div\n                key={item.product.id}\n                className=\"flex gap-3 border border-[#dbc2b0] p-3 rounded-lg bg-[#f9f9f9]\"\n              >\n                <img\n                  src={item.product.imageUrl}\n                  alt={item.product.title}\n                  className=\"w-20 h-20 object-contain bg-white rounded border border-gray-200 p-1 flex-shrink-0\"\n                />\n                <div className=\"flex-1 flex flex-col justify-between\">\n                  <div>\n                    <span className=\"text-[10px] font-bold uppercase text-[#914d00]\">\n                      {item.product.brand}\n                    </span>\n                    <h4 className=\"text-xs font-bold text-[#1a1c1c] line-clamp-2\">\n                      {item.product.title}\n                    </h4>\n                    <p className=\"text-sm font-bold text-[#914d00] mt-0.5\">\n                      {formatKsh(item.product.price)}\n                    </p>\n                  </div>\n\n                  <div className=\"flex items-center justify-between mt-2\">\n                    <div className=\"flex items-center border border-gray-300 rounded bg-white\">\n                      <button\n                        onClick={() =>\n                          onUpdateQuantity(item.product.id, item.quantity - 1)\n                        }\n                        className=\"px-2 py-0.5 text-xs text-gray-600 hover:bg-gray-100\"\n                      >\n                        -\n                      </button>\n                      <span className=\"px-2.5 py-0.5 text-xs font-bold\">\n                        {item.quantity}\n                      </span>\n                      <button\n                        onClick={() =>\n                          onUpdateQuantity(item.product.id, item.quantity + 1)\n                        }\n                        className=\"px-2 py-0.5 text-xs text-gray-600 hover:bg-gray-100\"\n                      >\n                        +\n                      </button>\n                    </div>\n\n                    <button\n                      onClick={() => onRemoveItem(item.product.id)}\n                      className=\"text-red-600 hover:text-red-800 text-xs flex items-center gap-0.5\"\n                    >\n                      <span className=\"material-symbols-outlined text-sm\">delete</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Cart Footer */}\n        {cartItems.length > 0 && (\n          <div className=\"p-5 border-t border-[#dbc2b0] bg-[#f9f9f9] space-y-3\">\n            <div className=\"flex justify-between items-center text-sm\">\n              <span className=\"text-gray-600\">Subtotal</span>\n              <span className=\"font-bold text-lg text-[#1a1c1c]\">\n                {formatKsh(totalKsh)}\n              </span>\n            </div>\n\n            <p className=\"text-[11px] text-gray-500 text-center\">\n              \342\234\223 KEBS Certified \342\200\242 KRA ETR Receipt included with every delivery\n            </p>\n\n            <div className=\"space-y-2\">\n              <button\n                onClick={generateWhatsAppOrder}\n                className=\"w-full bg-[#25D366] hover:bg-[#1EBE5C] text-white font-bold py-3 px-4 rounded-md text-sm flex items-center justify-center gap-2 shadow-sm transition-all\"\n              >\n                <svg className=\"w-5 h-5 fill-current\" viewBox=\"0 0 24 24\">\n                  <path d=\"M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.335.104 11.896c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.444h.004c6.58 0 11.939-5.335 11.939-11.896 0-3.176-1.24-6.165-3.468-8.447zM12.047 21.782h-.004c-1.78 0-3.524-.476-5.05-1.378l-.36-.214-3.766.983.998-3.655-.235-.373c-1-1.583-1.528-3.413-1.528-5.275 0-5.464 4.453-9.904 9.924-9.904 2.653 0 5.145 1.028 7.02 2.893 1.875 1.866 2.906 4.35 2.906 6.993 0 5.464-4.453 9.904-9.924 9.904z\" />\n                </svg>\n                Order via WhatsApp Direct\n              </button>\n\n              <button\n                onClick={() => setShowMpesaModal(true)}\n                className=\"w-full bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-3 px-4 rounded-md text-sm flex items-center justify-center gap-2 transition-colors\"\n              >\n                <span className=\"material-symbols-outlined text-lg\">payments</span>\n                Lipa na M-PESA Checkout\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* M-Pesa Checkout Modal */}\n      {showMpesaModal && (\n        <div className=\"fixed inset-0 z-[80] flex items-center justify-center p-4 bg-black/60\">\n          <div className=\"bg-white rounded-lg p-6 max-w-sm w-full relative shadow-xl\">\n            <button\n              onClick={() => setShowMpesaModal(false)}\n              className=\"absolute top-3 right-3 text-gray-500 hover:text-black\"\n            >\n              \342\234\225\n            </button>\n\n            <div className=\"text-center mb-4\">\n              <div className=\"inline-block bg-green-100 text-green-700 font-bold px-3 py-1 rounded text-xs mb-2\">\n                LIPA NA M-PESA EXPRESS\n              </div>\n              <h3 className=\"text-lg font-bold\">M-PESA Payment Request</h3>\n              <p className=\"text-xs text-gray-600 mt-1\">\n                Amount: <strong className=\"text-black\">{formatKsh(totalKsh)}</strong>\n              </p>\n            </div>\n\n            {mpesaSuccess ? (\n              <div className=\"text-center py-6 space-y-2\">\n                <div className=\"w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl\">\n                  \342\234\223\n                </div>\n                <h4 className=\"font-bold text-green-700\">M-PESA STK Push Sent!</h4>\n                <p className=\"text-xs text-gray-600\">\n                  Please check your phone and enter your PIN to complete the payment.\n                </p>\n              </div>\n            ) : (\n              <form onSubmit={handleMpesaSubmit} className=\"space-y-4\">\n                <div>\n                  <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                    Safaricom M-PESA Phone Number\n                  </label>\n                  <input\n                    type=\"tel\"\n                    required\n                    placeholder=\"0712 345 678\"\n                    value={phoneNumber}\n                    onChange={(e) => setPhoneNumber(e.target.value)}\n                    className=\"w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-green-600\"\n                  />\n                </div>\n\n                <div className=\"bg-gray-50 p-3 rounded text-[11px] text-gray-600 border border-gray-200\">\n                  Paybill: <strong>522522</strong> | Account: <strong>FundiPro</strong>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  disabled={isProcessing}\n                  className=\"w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 rounded text-sm transition-colors flex items-center justify-center gap-2\"\n                >\n                  {isProcessing ? \'Prompting M-PESA...\' : \'Send STK Push Prompt\'}\n                </button>\n              </form>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
