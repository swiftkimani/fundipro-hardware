      target_content: "        {/* Cart Header */}\n        <div className=\"p-5 border-b border-[#dbc2b0] flex justify-between items-center bg-[#f9f9f9]\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#914d00]\">shopping_cart</span>\n            <h2 className=\"text-lg font-bold font-headline text-[#1a1c1c]\">\n              Your Shopping Cart ({cartItems.reduce((acc, i) => acc + i.quantity, 0)})\n            </h2>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-md text-[#554336] hover:bg-gray-200 transition-colors\"\n          >\n            <span className=\"material-symbols-outlined\">close</span>\n          </button>\n        </div>\n\n        {/* Cart Items List */}\n        <div className=\"flex-1 overflow-y-auto p-5 space-y-4\">\n          {cartItems.length === 0 ? (\n            <div className=\"text-center py-12 text-[#554336]\">\n              <span className=\"material-symbols-outlined text-5xl mb-2 text-gray-300\">\n                remove_shopping_cart\n              </span>\n              <p className=\"font-semibold\">Your cart is empty</p>\n              <p className=\"text-xs text-gray-500 mt-1\">\n                Browse our hardware deals and add materials or tools to your order.\n              </p>\n            </div>\n          ) : (\n            cartItems.map((item) => (\n              <div\n                key={item.product.id}\n                className=\"flex gap-3 border border-[#dbc2b0] p-3 rounded-lg bg-[#f9f9f9]\"\n              >\n                <img\n                  src={item.product.imageUrl}\n                  alt={item.product.title}\n                  className=\"w-20 h-20 object-contain bg-white rounded border border-gray-200 p-1 flex-shrink-0\"\n                />\n                <div className=\"flex-1 flex flex-col justify-between\">\n                  <div>\n                    <span className=\"