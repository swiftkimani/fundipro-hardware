    replacement_chunks {
      target_content: "      {/* Header */}\n      <div className=\"max-w-3xl mb-12\">\n        <span className=\"bg-[#f28c28] text-[#5d2f00] text-xs font-bold uppercase tracking-wider px-3 py-1 rounded\">\n          About FundiPro Hardware Ltd\n        </span>\n        <h1 className=\"text-3xl md:text-5xl font-extrabold font-headline text-[#914d00] mt-3 mb-6\">\n          Powering Kenya\'s Construction Industry\n        </h1>\n        <p className=\"text-base text-[#554336] leading-relaxed\">\n          Founded in Nairobi in 2012, FundiPro Hardware Ltd has grown to become Kenya\'s leading distributor of professional power tools, high-tensile steel, cement, and roofing solutions. We bridges the gap between major manufacturers and local contractors.\n        </p>\n      </div>\n\n      {/* Stats Counter Bar */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 bg-[#e8e8e8] border border-[#dbc2b0] rounded-lg p-6 text-center\">\n        <div>\n          <span className=\"text-3xl font-extrabold font-headline text-[#914d00] block\">\n            15,000+\n          </span>\n          <span className=\"text-xs text-[#554336] font-semibold\">Tonnes Steel Supplied</span>\n        </div>\n        <div>\n          <span className=\"text-3xl font-extrabold font-headline text-[#914d00] block\">\n            500+\n          </span>\n          <span className=\"text-xs text-[#554336] font-semibold\">Commercial Projects</span>\n        </div>\n        <div>\n          <span className=\"text-3xl font-extrabold font-headline text-[#914d00] block\">\n            100%\n          </span>\n          <span className=\"text-xs text-[#554336] font-semibold\">KEBS Certified</span>\n        </div>\n        <div>\n          <span className=\"text-3xl font-extrabold font-headline text-[#914d00] block\">\n            47\n          </span>\n          <span className=\"text-xs text-[#554336] font-semibold\">Counties Delivered</span>\n        </div>\n      </div>\n\n      {/* Core Values / Commitments */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 mb-16\">\n        <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-6 shadow-xs\">\n          <span className=\"material-symbols-outlined text-3xl text-[#914d00] mb-3\">\n            verified\n          </span>\n          <h3 className=\"text-lg font-bold font-headline text-[#1a1c1c] mb-2\">\n            KEBS Quality Guarantee\n          </h3>\n          <p className=\"text-xs text-[#554336] leading-relaxed\">\n            We strictly stock genuine products from certified brands like Bosch, Makita, Bamburi, and Rhino Mabati. Every batch undergoes strict quality checks.\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-6 shadow-xs\">\n          <span className=\"material-symbols-outlined text-3xl text-[#914d00] mb-3\">\n            receipt_long\n          </span>\n          <h3 className=\"text-lg font-bold font-headline text-[#1a1c1c] mb-2\">\n            100% KRA Tax Compliance\n          </h3>\n          <p className=\"text-xs text-[#554336] leading-relaxed\">\n            All purchases include ETR invoices with TIMS validation. We facilitate seamless input tax claims for registered construction firms.\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-6 shadow-xs\">\n          <span className=\"material-symbols-outlined text-3xl text-[#914d00] mb-3\">\n            handyman\n          </span>\n          <h3 className=\"text-lg font-bold font-headline text-[#1a1c1c] mb-2\">\n            Fundi-First Support\n          </h3>\n          <p className=\"text-xs text-[#554336] leading-relaxed\">\n            Whether you need a single replacement angle grinder or 1,000 bags of cement, our technical team provides hands-on expert consultation.\n          </p>\n        </div>\n      </div>\n\n      {/* Branch Network */}\n      <div className=\"border-t border-[#dbc2b0] pt-12\">\n        <h2 className=\"text-2xl font-bold font-headline text-[#914d00] mb-6\">\n          Our Branch Network\n        </h2>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {branches.map((branch, idx) => (\n            <div\n              key={idx}\n              className=\"bg-white border border-[#dbc2b0] rounded-lg p-6 shadow-xs flex flex-col justify-between\"\n            >\n              <div>\n                <span className=\"bg-[#ffdcc3] text-[#5d2f00] text-[10px] font-bold uppercase px-2 py-0.5 rounded\">\n                  {branch.city}\n                </span>\n                <h3 className=\"text-xl font-bold font-headline text-[#1a1c1c] mt-2 mb-3\">\n                  {branch.name}\n                </h3>\n\n                <ul className=\"space-y-2 text-xs text-[#554336] mb-6\">\n                  <li className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-base text-[#914d00]\">\n                      location_on\n                    </span>\n                    <span>{branch.address}, {branch.city}</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-base text-[#914d00]\">\n                      call\n                    </span>\n                    <span>{branch.phone}</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-base text-[#914d00]\">\n                      mail\n                    </span>\n                    <span>{branch.email}</span>\n                  </li>\n                  <li className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-base text-[#914d00]\">\n                      schedule\n                    </span>\n                    <span>{branch.hours}</span>\n                  </li>\n                </ul>\n              </div>\n\n              <a\n                href={`https://wa.me/${branch.whatsapp}`}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"w-full bg-[#25D366] hover:bg-[#1EBE5C] text-white font-bold py-2.5 px-4 rounded text-xs flex items-center justify-center gap-2 transition-colors\"\n              >\n                Contact {branch.name} on WhatsApp\n              </a>\n            </div>\n          ))}\n        </div>\n      </div>"
      replacement_content: "      {/* Header */}\n      <div className=\"max-w-3xl mb-12\">\n        <span className=\"text-[10px] tracking-[0.25em] font-bold uppercase text-[#b45309] block mb-2\">\n          ORGANIZATION ARCHIVE\n        </span>\n        <h1 className=\"text-3xl md:text-5xl font-serif font-bold text-[#1A1A1A] mt-2 mb-6 tracking-tight italic\">\n          Powering Kenya\'s Construction Industry\n        </h1>\n        <p className=\"text-sm text-black/70 leading-relaxed font-sans\">\n          Founded in Nairobi in 2012, FundiPro Hardware Ltd has grown to become Kenya\'s leading distributor of professional power tools, high-tensile steel, cement, and roofing solutions. We bridge the gap between major global manufacturers and local contractors.\n        </p>\n      </div>\n\n      {/* Stats Counter Bar */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 bg-[#EFECE6] border border-black/10 p-6 text-center\">\n        <div>\n          <span className=\"text-3xl md:text-4xl font-serif italic font-bold text-[#1A1A1A] block\">\n            15,000+\n          </span>\n          <span className=\"text-[10px] tracking-[0.15em] font-bold uppercase text-black/60\">Tonnes Steel Supplied</span>\n        </div>\n        <div>\n          <span className=\"text-3xl md:text-4xl font-serif italic font-bold text-[#1A1A1A] block\">\n            500+\n          </span>\n          <span className=\"text-[10px] tracking-[0.15em] font-bold uppercase text-black/60\">Commercial Projects</span>\n        </div>\n        <div>\n          <span className=\"text-3xl md:text-4xl font-serif italic font-bold text-[#b45309] block\">\n            100%\n          </span>\n          <span className=\"text-[10px] tracking-[0.15em] font-bold uppercase text-black/60\">KEBS Certified</span>\n        </div>\n        <div>\n          <span className=\"text-3xl md:text-4xl font-serif italic font-bold text-[#1A1A1A] block\">\n            47\n          </span>\n          <spa