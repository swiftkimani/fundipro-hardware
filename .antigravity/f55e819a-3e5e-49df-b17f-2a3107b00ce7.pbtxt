  file_change {
    absolute_path_uri: "file:///src/views/ShopView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Product, FilterState } from \'../types\';\nimport { TrustBanner } from \'../components/TrustBanner\';\n\ninterface ShopViewProps {\n  featuredDeals: Product[];\n  products: Product[];\n  filters: FilterState;\n  setFilters: React.Dispatch<React.SetStateAction<FilterState>>;\n  onAddToCart: (product: Product, quantity: number) => void;\n  onSelectProduct: (product: Product) => void;\n  onRequestQuote: () => void;\n}\n\nexport const ShopView: React.FC<ShopViewProps> = ({\n  featuredDeals,\n  products,\n  filters,\n  setFilters,\n  onAddToCart,\n  onSelectProduct,\n  onRequestQuote,\n}) => {\n  const [currentPage, setCurrentPage] = React.useState(1);\n\n  // Categories & Brands list\n  const categoriesList = [\n    { name: \'Power Tools\', count: 45 },\n    { name: \'Hand Tools - Fundi\', count: 112 },\n    { name: \'Building Materials\', count: 89 },\n    { name: \'Roofing (Mabati)\', count: 24 },\n  ];\n\n  const brandsList = [\'Bosch\', \'Makita\', \'Bamburi\', \'Rhino Mabati\', \'DeWalt\', \'Stanley\'];\n\n  const toggleCategory = (category: string) => {\n    setFilters((prev) => {\n      const exists = prev.categories.includes(category);\n      const updated = exists\n        ? prev.categories.filter((c) => c !== category)\n        : [...prev.categories, category];\n      return { ...prev, categories: updated };\n    });\n  };\n\n  const toggleBrand = (brand: string) => {\n    setFilters((prev) => {\n      const exists = prev.brands.includes(brand);\n      const updated = exists\n        ? prev.brands.filter((b) => b !== brand)\n        : [...prev.brands, brand];\n      return { ...prev, brands: updated };\n    });\n  };\n\n  const handlePriceApply = (e: React.FormEvent) => {\n    e.preventDefault();\n    // Forces re-render / filter application\n  };\n\n  const openWhatsAppItemInquiry = (product: Product, e: React.MouseEvent) => {\n    e.stopPropagation();\n    const text = `Hello FundiPro Hardware! I want to inquire about *${product.title}* (${product.brand}) priced at KSh ${product.price.toLocaleString()}. Please confirm stock.`;\n    window.open(`https://wa.me/254700123456?text=${encodeURIComponent(text)}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"w-full max-w-7xl mx-auto px-4 md:px-12 py-6\">\n      {/* Trust Banner */}\n      <TrustBanner />\n\n      {/* Featured Industrial Deals Bento */}\n      <section className=\"mb-12\">\n        <h2 className=\"text-xl md:text-2xl font-bold font-headline text-[#1a1c1c] mb-6 border-b border-[#dbc2b0] pb-2\">\n          Featured Industrial Deals\n        </h2>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {/* Large Featured Item (Bamburi Cement) */}\n          {featuredDeals[0] && (\n            <div\n              onClick={() => onSelectProduct(featuredDeals[0])}\n              className=\"md:col-span-2 bg-[#e2e2e2] rounded-lg overflow-hidden border border-[#dbc2b0] relative group cursor-pointer shadow-xs hover:shadow-md transition-shadow\"\n            >\n              <div className=\"absolute inset-0 bg-black/10 group-hover:bg-black/5 transition-colors z-10 pointer-events-none\" />\n              <img\n                src={featuredDeals[0].imageUrl}\n                alt={featuredDeals[0].title}\n                className=\"w-full h-[300px] object-cover mix-blend-multiply\"\n              />\n              <div className=\"absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white z-20\">\n                <span className=\"bg-[#f28c28] text-[#5d2f00] font-bold text-xs uppercase px-2.5 py-1 rounded inline-block mb-2\">\n                  {featuredDeals[0].badge || \'Bulk Offer\'}\n                </span>\n                <h3 className=\"text-2xl font-bold font-headline mb-1.5\">\n                  {featuredDeals[0].title}\n                </h3>\n                <p className=\"text-2xl font-bold text-[#ffdcc3] flex items-baseline gap-2\">\n                  KSh {featuredDeals[0].price.toLocaleString()}\n                  {featuredDeals[0].originalPrice && (\n                    <span className=\"text-sm font-normal line-through opacity-75\">\n                      KSh {featuredDeals[0].originalPrice.toLocaleString()}\n                    </span>\n                  )}\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* Small Featured Item (D12 High Tensile Steel) */}\n          {featuredDeals[1] && (\n            <div\n              onClick={() => onSelectProduct(featuredDeals[1])}\n              className=\"md:col-span-1 bg-[#e2e2e2] rounded-lg overflow-hidden border border-[#dbc2b0] relative group cursor-pointer shadow-xs hover:shadow-md transition-shadow\"\n            >\n              <img\n                src={featuredDeals[1].imageUrl}\n                alt={featuredDeals[1].title}\n                className=\"w-full h-[300px] object-cover mix-blend-multiply\"\n              />\n              <div className=\"absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white z-20\">\n                <h3 className=\"text-lg font-bold font-headline mb-1\">\n                  {featuredDeals[1].title}\n                </h3>\n                <p className=\"text-xl font-bold text-[#ffdcc3]\">\n                  KSh {featuredDeals[1].price.toLocaleString()}\n                  <span className=\"text-xs font-normal opacity-75\"> / pc</span>\n                </p>\n              </div>\n            </div>\n          )}\n        </div>\n      </section>\n\n      {/* Filter Sidebar & Product Grid Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8\">\n        {/* Sidebar Filters */}\n        <aside className=\"md:col-span-3 space-y-6\">\n          <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-5 shadow-xs\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-[#1a1c1c] mb-4 pb-2 border-b border-[#dbc2b0]\">\n              Filter Products\n            </h3>\n\n            {/* Category Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">Category</h4>\n              <div className=\"space-y-2\">\n                {categoriesList.map((cat) => (\n                  <label\n                    key={cat.name}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.categories.includes(cat.name)}\n                      onChange={() => toggleCategory(cat.name)}\n                      className=\"rounded text-[#914d00] focus:ring-[#914d00] h-4 w-4 border-[#887364]\"\n                    />\n                    <span className=\"text-[#554336] group-hover:text-[#914d00] transition-colors\">\n                      {cat.name} ({cat.count})\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Brand Filter */}\n            <div className=\"mb-6\">\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">Brands</h4>\n              <div className=\"space-y-2\">\n                {brandsList.map((brand) => (\n                  <label\n                    key={brand}\n                    className=\"flex items-center gap-2 cursor-pointer group text-xs\"\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={filters.brands.includes(brand)}\n                      onChange={() => toggleBrand(brand)}\n                      className=\"rounded text-[#914d00] focus:ring-[#914d00] h-4 w-4 border-[#887364]\"\n                    />\n                    <span className=\"text-[#554336] group-hover:text-[#914d00] transition-colors\">\n                      {brand}\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n\n            {/* Price Filter */}\n            <div>\n              <h4 className=\"text-sm font-bold mb-3 text-[#1a1c1c]\">\n                Price Range (KSh)\n              </h4>\n              <form onSubmit={handlePriceApply} className=\"space-y-3\">\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    value={filters.minPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, minPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-[#887364] rounded px-2.5 py-1.5 text-xs bg-white text-[#1a1c1c] focus:outline-none focus:border-[#914d00]\"\n                  />\n                  <span className=\"text-gray-500\">-</span>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    value={filters.maxPrice}\n                    onChange={(e) =>\n                      setFilters((prev) => ({ ...prev, maxPrice: e.target.value }))\n                    }\n                    className=\"w-full border border-[#887364] rounded px-2.5 py-1.5 text-xs bg-white text-[#1a1c1c] focus:outline-none focus:border-[#914d00]\"\n                  />\n                </div>\n                <button\n                  type=\"submit\"\n                  className=\"w-full border border-[#1a1c1c] text-[#1a1c1c] font-bold py-2 rounded text-xs hover:bg-[#e4e2e1] transition-colors\"\n                >\n                  Apply Filter\n                </button>\n              </form>\n            </div>\n          </div>\n\n          {/* Bulk Quote CTA Banner */}\n          <div className=\"bg-[#5d2f00] text-white rounded-lg p-5 border border-[#f28c28]/40 space-y-3\">\n            <h4 className=\"font-bold text-sm text-[#ffdcc3]\">Bulk Contractor Orders</h4>\n            <p className=\"text-xs opacity-90 leading-relaxed\">\n              Ordering for a major building site? Request customized volume quotes with site delivery options across Kenya.\n            </p>\n            <button\n              onClick={onRequestQuote}\n              className=\"w-full bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-2 px-3 rounded text-xs transition-colors\"\n            >\n              Request Bulk Quote\n            </button>\n          </div>\n        </aside>\n\n        {/* Product Catalogue Grid */}\n        <section className=\"md:col-span-9\">\n          {/* Sorting Header */}\n          <div className=\"flex flex-col sm:flex-row justify-between items-center mb-6 pb-4 border-b border-[#dbc2b0] gap-4\">\n            <p className=\"text-xs text-[#554336]\">\n              Showing <strong className=\"text-[#1a1c1c]\">{products.length}</strong>{\' \'}\n              results for{\' \'}\n              <span className=\"font-bold text-[#1a1c1c]\">\n                \"{filters.searchQuery ? filters.searchQuery : \'All Products\'}\"\n              </span>\n            </p>\n\n            <div className=\"flex items-center gap-2\">\n              <label className=\"text-xs text-[#554336]\">Sort by:</label>\n              <select\n                value={filters.sortBy}\n                onChange={(e) =>\n                  setFilters((prev) => ({\n                    ...prev,\n                    sortBy: e.target.value as FilterState[\'sortBy\'],\n                  }))\n                }\n                className=\"border border-[#887364] rounded px-3 py-1 bg-white text-xs text-[#1a1c1c] focus:outline-none focus:border-[#914d00]\"\n              >\n                <option value=\"relevance\">Relevance</option>\n                <option value=\"price-low\">Price: Low to High</option>\n                <option value=\"price-high\">Price: High to Low</option>\n                <option value=\"newest\">Newest Arrivals</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Product Cards */}\n          {products.length === 0 ? (\n            <div className=\"bg-white border border-[#dbc2b0] rounded-lg p-12 text-center text-[#554336]\">\n              <span className=\"material-symbols-outlined text-4xl text-gray-300 mb-2\">\n                search_off\n              </span>\n              <h3 className=\"font-bold text-base text-[#1a1c1c]\">No matching products found</h3>\n              <p className=\"text-xs mt-1\">\n                Try clearing search or unchecking some category filters.\n              </p>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n              {products.map((product) => (\n                <div\n                  key={product.id}\n                  onClick={() => onSelectProduct(product)}\n                  className=\"bg-white border border-[#dbc2b0] rounded-lg overflow-hidden flex flex-col hover:shadow-lg transition-shadow duration-300 cursor-pointer group\"\n                >\n                  {/* Card Image Container */}\n                  <div className=\"h-48 bg-[#F2F2F2] flex items-center justify-center p-4 relative\">\n                    <img\n                      src={product.imageUrl}\n                      alt={product.title}\n                      className=\"max-h-full max-w-full object-contain mix-blend-darken group-hover:scale-105 transition-transform duration-300\"\n                    />\n                    {product.badge && (\n                      <span className=\"absolute top-2 left-2 bg-[#f28c28] text-[#5d2f00] font-bold text-[10px] px-2 py-0.5 rounded\">\n                        {product.badge}\n                      </span>\n                    )}\n                  </div>\n\n                  {/* Card Info */}\n                  <div className=\"p-4 flex flex-col flex-grow\">\n                    <span className=\"text-[10px] font-bold uppercase tracking-wider text-[#554336] mb-1\">\n                      {product.brand}\n                    </span>\n                    <h3 className=\"text-sm font-bold text-[#1a1c1c] mb-2 line-clamp-2 min-h-[2.5rem]\">\n                      {product.title}\n                    </h3>\n\n                    {/* Spec List Box */}\n                    <ul className=\"spec-list text-[11px] text-[#554336] mb-4 rounded border border-[#dbc2b0] overflow-hidden\">\n                      {product.specs.slice(0, 3).map((spec, idx) => (\n                        <li key={idx} className=\"px-2 py-1 flex justify-between\">\n                          <span>{spec.label}</span>\n                          <span className=\"font-semibold text-[#1a1c1c]\">\n                            {spec.value}\n                          </span>\n                        </li>\n                      ))}\n                    </ul>\n\n                    {/* Price & Actions */}\n                    <div className=\"mt-auto pt-2 border-t border-gray-100\">\n                      <p className=\"text-lg font-bold text-[#1a1c1c] mb-3\">\n                        KSh {product.price.toLocaleString()}\n                        {product.unit && (\n                          <span className=\"text-xs font-normal text-gray-500\">\n                            {\' \'}\n                            {product.unit}\n                          </span>\n                        )}\n                      </p>\n\n                      <div className=\"flex gap-2\">\n                        <button\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            onAddToCart(product, 1);\n                          }}\n                          className=\"flex-1 bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-2 px-3 rounded text-xs flex justify-center items-center gap-1.5 transition-colors shadow-xs\"\n                        >\n                          <span className=\"material-symbols-outlined text-base\">\n                            add_shopping_cart\n                          </span>\n                          Add\n                        </button>\n\n                        <button\n                          onClick={(e) => openWhatsAppItemInquiry(product, e)}\n                          className=\"border border-[#25D366] text-[#25D366] hover:bg-[#25D366]/10 p-2 rounded flex justify-center items-center transition-colors\"\n                          title=\"Inquire via WhatsApp\"\n                        >\n                          <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                            <path d=\"M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.335.104 11.896c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.444h.004c6.58 0 11.939-5.335 11.939-11.896 0-3.176-1.24-6.165-3.468-8.447zM12.047 21.782h-.004c-1.78 0-3.524-.476-5.05-1.378l-.36-.214-3.766.983.998-3.655-.235-.373c-1-1.583-1.528-3.413-1.528-5.275 0-5.464 4.453-9.904 9.924-9.904 2.653 0 5.145 1.028 7.02 2.893 1.875 1.866 2.906 4.35 2.906 6.993 0 5.464-4.453 9.904-9.924 9.904z\" />\n                          </svg>\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n\n          {/* Pagination */}\n          <div className=\"mt-12 flex justify-center items-center gap-2 text-xs\">\n            <button\n              onClick={() => setCurrentPage(Math.max(1, currentPage - 1))}\n              disabled={currentPage === 1}\n              className=\"w-9 h-9 flex items-center justify-center border border-[#887364] rounded bg-white text-[#1a1c1c] hover:bg-[#e4e2e1] transition-colors disabled:opacity-50\"\n            >\n              <span className=\"material-symbols-outlined text-base\">chevron_left</span>\n            </button>\n\n            <button\n              onClick={() => setCurrentPage(1)}\n              className={`w-9 h-9 flex items-center justify-center border rounded font-bold ${\n                currentPage === 1\n                  ? \'border-[#914d00] bg-[#914d00] text-white\'\n                  : \'border-[#887364] bg-white text-[#1a1c1c] hover:bg-[#e4e2e1]\'\n              }`}\n            >\n              1\n            </button>\n\n            <button\n              onClick={() => setCurrentPage(2)}\n              className={`w-9 h-9 flex items-center justify-center border rounded font-bold ${\n                currentPage === 2\n                  ? \'border-[#914d00] bg-[#914d00] text-white\'\n                  : \'border-[#887364] bg-white text-[#1a1c1c] hover:bg-[#e4e2e1]\'\n              }`}\n            >\n              2\n            </button>\n\n            <button\n              onClick={() => setCurrentPage(3)}\n              className={`w-9 h-9 flex items-center justify-center border rounded font-bold ${\n                currentPage === 3\n                  ? \'border-[#914d00] bg-[#914d00] text-white\'\n                  : \'border-[#887364] bg-white text-[#1a1c1c] hover:bg-[#e4e2e1]\'\n              }`}\n            >\n              3\n            </button>\n\n            <span className=\"w-9 h-9 flex items-center justify-center text-gray-500\">\n              ...\n            </span>\n\n            <button\n              onClick={() => setCurrentPage(currentPage + 1)}\n              className=\"w-9 h-9 flex items-center justify-center border border-[#887364] rounded bg-white text-[#1a1c1c] hover:bg-[#e4e2e1] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-base\">chevron_right</span>\n            </button>\n          </div>\n        </section>\n      </div>\n    </div>\n  );\n};\n"
