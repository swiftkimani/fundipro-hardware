    replacement_chunks {
      target_content: "    <div className=\"fixed inset-0 z-[80] flex items-center justify-center p-4 bg-black/60\">\n      <div className=\"bg-[#f9f9f9] border border-[#dbc2b0] rounded-lg max-w-lg w-full p-6 relative shadow-2xl overflow-hidden\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 text-[#554336] hover:text-black p-1\"\n        >\n          <span className=\"material-symbols-outlined\">close</span>\n        </button>\n\n        <div className=\"mb-6\">\n          <span className=\"bg-[#f28c28] text-[#5d2f00] text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded\">\n            Bulk Supply &amp; BOQ\n          </span>\n          <h2 className=\"text-xl font-bold font-headline text-[#1a1c1c] mt-1\">\n            Request an Industrial Bulk Quote\n          </h2>\n          <p className=\"text-xs text-[#554336] mt-1\">\n            Partner with FundiPro for volume discounts on cement, steel, mabati, and power tools. Dedicated account managers assigned within 1 hour.\n          </p>\n        </div>\n\n        {submitted ? (\n          <div className=\"bg-green-50 border border-green-200 p-6 rounded-lg text-center space-y-2 my-4\">\n            <span className=\"material-symbols-outlined text-4xl text-green-600\">\n              task_alt\n            </span>\n            <h3 className=\"font-bold text-green-800 text-lg\">\n              Quote Request Submitted!\n            </h3>\n            <p className=\"text-xs text-green-700\">\n              Reference: <strong>#FP-2026-{Math.floor(1000 + Math.random() * 9000)}</strong>\n            </p>\n            <p className=\"text-xs text-gray-600\">\n              Our Pro Account Manager will call or WhatsApp you shortly with discounted pricing and delivery schedules.\n            </p>\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Full Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. John Kamau\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Phone / WhatsApp Number *\n                </label>\n                <input\n                  type=\"tel\"\n                  required\n                  placeholder=\"0700 000 000\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Email Address\n                </label>\n                <input\n                  type=\"email\"\n                  placeholder=\"john@construction.co.ke\"\n                  value={formData.email}\n                  onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Company / Project Name\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Kilimani Apartments Site\"\n                  value={formData.companyName}\n                  onChange={(e) => setFormData({ ...formData, companyName: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Primary Category Required\n                </label>\n                <select\n                  value={formData.category}\n                  onChange={(e) => setFormData({ ...formData, category: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                >\n                  <option>Building Materials (Cement, Steel)</option>\n                  <option>Roofing (Mabati Sheets)</option>\n                  <option>Power Tools &amp; Machinery</option>\n                  <option>Commercial Electricals &amp; Conduits</option>\n                  <option>Plumbing &amp; Industrial Piping</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  Servicing Branch\n                </label>\n                <select\n                  value={formData.branch}\n                  onChange={(e) => setFormData({ ...formData, branch: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                >\n                  <option>Nairobi Main Branch (Industrial Area)</option>\n                  <option>Mombasa Coastal Branch (Mbaraki)</option>\n                  <option>Upcountry Nationwide Direct Site Delivery</option>\n                </select>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                List Required Quantities or BOQ Details\n              </label>\n              <textarea\n                rows={3}\n                placeholder=\"e.g., 200 bags Bamburi Cement, 50 pcs D12 rebar, 30 sheets Rhino Mabati, delivery to Westlands Nairobi site...\"\n                value={formData.message}\n                onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n              ></textarea>\n            </div>\n\n            <div className=\"pt-2 flex gap-3\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"flex-1 py-2.5 border border-[#887364] text-[#1a1c1c] font-bold rounded hover:bg-gray-100 transition-colors text-sm\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"flex-1 py-2.5 bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold rounded transition-colors text-sm shadow-xs\"\n              >\n                Submit Quote Request\n              </button>\n            </div>\n          </form>\n        )}\n      </div>\n    </div>"
      replacement_content: "    <div className=\"fixed inset-0 z-[80] flex items-center justify-center p-4 bg-black/60\">\n      <div className=\"bg-white border border-black/20 max-w-lg w-full p-6 md:p-8 relative shadow-2xl overflow-hidden\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 text-black/50 hover:text-black p-1 transition-colors\"\n        >\n          <span className=\"material-symbols-outlined\">close</span>\n        </button>\n\n        <div className=\"mb-6\">\n          <span className=\"bg-[#1A1A1A] text-white text-[9px] font-bold tracking-[0.2em] uppercase px-2.5 py-1 mb-2 inline-block\">\n            BULK SUPPLY &amp; BOQ\n          </span>\n          <h2 className=\"text-xl md:text-2xl font-serif font-bold text-[#1A1A1A] mt-1 tracking-tight\">\n            Request an Industrial Bulk Quote\n          </h2>\n          <p className=\"text-xs text-black/60 mt-1 font-sans\">\n            Partner with FundiPro for volume discounts on cement, steel, mabati, and power tools with dedicated account management.\n          </p>\n        </div>\n\n        {submitted ? (\n          <div className=\"bg-[#EFECE6] border border-black/15 p-6 text-center space-y-2 my-4\">\n            <span className=\"material-symbols-outlined text-4xl text-[#b45309]\">\n              task_alt\n            </span>\n            <h3 className=\"font-serif font-bold text-[#1A1A1A] text-lg\">\n              Quote Request Submitted!\n            </h3>\n            <p className=\"text-xs text-black/70 font-sans\">\n              Reference: <strong className=\"text-[#1A1A1A]\">#FP-2026-{Math.floor(1000 + Math.random() * 9000)}</strong>\n            </p>\n            <p className=\"text-xs text-black/60 font-sans\">\n              Our Pro Account Manager will contact you shortly with discounted pricing and delivery schedules.\n            </p>\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Full Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. John Kamau\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Phone / WhatsApp Number *\n                </label>\n                <input\n                  type=\"tel\"\n                  required\n                  placeholder=\"0700 000 000\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Email Address\n                </label>\n                <input\n                  type=\"email\"\n                  placeholder=\"john@construction.co.ke\"\n                  value={formData.email}\n                  onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Company / Project Name\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Kilimani Apartments Site\"\n                  value={formData.companyName}\n                  onChange={(e) => setFormData({ ...formData, companyName: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Primary Category Required\n                </label>\n                <select\n                  value={formData.category}\n                  onChange={(e) => setFormData({ ...formData, category: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                >\n                  <option>Building Materials (Cement, Steel)</option>\n                  <option>Roofing (Mabati Sheets)</option>\n                  <option>Power Tools &amp; Machinery</option>\n                  <option>Commercial Electricals &amp; Conduits</option>\n                  <option>Plumbing &amp; Industrial Piping</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                  Servicing Branch\n                </label>\n                <select\n                  value={formData.branch}\n                  onChange={(e) => setFormData({ ...formData, branch: e.target.value })}\n                  className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n                >\n                  <option>Nairobi Main Branch (Industrial Area)</option>\n                  <option>Mombasa Coastal Branch (Mbaraki)</option>\n                  <option>Upcountry Nationwide Direct Site Delivery</option>\n                </select>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block uppercase tracking-wider text-[10px] font-bold text-[#1A1A1A] mb-1\">\n                List Required Quantities or BOQ Details\n              </label>\n              <textarea\n                rows={3}\n                placeholder=\"e.g., 200 bags Bamburi Cement, 50 pcs D12 rebar, 30 sheets Rhino Mabati, delivery to Westlands Nairobi site...\"\n                value={formData.message}\n                onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                className=\"w-full border border-black/15 px-3 py-2 bg-[#F5F2ED] text-xs text-[#1A1A1A] focus:outline-none focus:border-black focus:bg-white\"\n              ></textarea>\n            </div>\n\n            <div className=\"pt-2 flex gap-3\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"flex-1 py-3 border border-black/20 text-[#1A1A1A] font-bold hover:bg-black/5 transition-colors text-[10px] tracking-[0.2em] uppercase cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"flex-1 py-3 bg-[#1A1A1A] hover:bg-[#b45309] text-white font-bold transition-colors text-[10px] tracking-[0.2em] uppercase cursor-pointer\"\n              >\n                Submit Quote Request\n              </button>\n            </div>\n          </form>\n        )}\n      </div>\n    </div>"
