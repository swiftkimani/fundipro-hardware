    replacement_chunks {
      target_content: "    <div className=\"fixed inset-0 z-[75] flex items-center justify-center p-4 bg-black/60\">\n      <div className=\"bg-white border border-[#dbc2b0] rounded-lg max-w-2xl w-full p-6 relative shadow-2xl overflow-hidden max-h-[90vh] flex flex-col md:flex-row gap-6\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-3 right-3 z-10 text-gray-500 hover:text-black p-1 rounded-full bg-gray-100 hover:bg-gray-200\"\n        >\n          <span className=\"material-symbols-outlined\">close</span>\n        </button>\n\n        {/* Product Image */}\n        <div className=\"w-full md:w-1/2 h-64 md:h-auto bg-[#F2F2F2] rounded-lg p-4 flex items-center justify-center relative flex-shrink-0\">\n          <img\n            src={product.imageUrl}\n            alt={product.title}\n            className=\"max-h-full max-w-full object-contain mix-blend-darken\"\n          />\n          {product.badge && (\n            <span className=\"absolute top-3 left-3 bg-[#f28c28] text-[#5d2f00] font-bold text-[10px] uppercase px-2 py-1 rounded\">\n              {product.badge}\n            </span>\n          )}\n        </div>\n\n        {/* Details Content */}\n        <div className=\"w-full md:w-1/2 flex flex-col justify-between overflow-y-auto pr-1\">\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#554336]\">\n              {product.brand} \342\200\242 {product.category}\n            </span>\n            <h2 className=\"text-xl font-bold font-headline text-[#1a1c1c] mt-1 mb-2\">\n              {product.title}\n            </h2>\n\n            <div className=\"flex items-center gap-2 mb-3\">\n              <span className=\"text-2xl font-bold text-[#1a1c1c]\">\n                KSh {product.price.toLocaleString()}\n              </span>\n              {product.unit && (\n                <span className=\"text-xs text-gray-500 font-normal\">\n                  {product.unit}\n                </span>\n              )}\n              {product.originalPrice && (\n                <span className=\"text-xs text-gray-400 line-through\">\n                  KSh {product.originalPrice.toLocaleString()}\n                </span>\n              )}\n            </div>\n\n            <p className=\"text-xs text-[#554336] leading-relaxed mb-4\">\n              {product.description}\n            </p>\n\n            {/* Spec Sheet Table */}\n            <div className=\"mb-4\">\n              <h4 className=\"text-xs font-bold uppercase text-gray-700 mb-2\">\n                Technical Specifications\n              </h4>\n              <ul className=\"spec-list text-xs text-[#554336] rounded border border-[#dbc2b0] overflow-hidden\">\n                {product.specs.map((spec, idx) => (\n                  <li key={idx} className=\"px-3 py-1.5 flex justify-between\">\n                    <span className=\"text-gray-600\">{spec.label}</span>\n                    <span className=\"font-bold text-[#1a1c1c]\">{spec.value}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          <div className=\"space-y-3 pt-3 border-t border-gray-200\">\n            {/* Quantity Selector */}\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-gray-700\">Quantity</span>\n              <div className=\"flex items-center border border-gray-300 rounded bg-white\">\n                <button\n                  onClick={() => setQuantity(Math.max(1, quantity - 1))}\n                  className=\"px-3 py-1 text-xs text-gray-600 hover:bg-gray-100\"\n                >\n                  -\n                </button>\n                <span className=\"px-3 py-1 text-xs font-bold\">{quantity}</span>\n                <button\n                  onClick={() => setQuantity(quantity + 1)}\n                  className=\"px-3 py-1 text-xs text-gray-600 hover:bg-gray-100\"\n                >\n                  +\n                </button>\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleAdd}\n                className=\"flex-1 bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-2.5 px-4 rounded text-xs flex justify-center items-center gap-1.5 transition-colors shadow-xs\"\n              >\n                <span className=\"material-symbols-outlined text-base\">add_shopping_cart</span>\n                {addedToast ? \'Added to Cart \342\234\223\' : \'Add to Cart\'}\n              </button>\n\n              <button\n                onClick={openWhatsAppInquiry}\n                className=\"py-2.5 px-3 border border-[#25D366] text-[#25D366] hover:bg-[#25D366]/10 font-bold rounded text-xs flex items-center justify-center gap-1 transition-colors\"\n                title=\"Inquire via WhatsApp\"\n              >\n                <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                  <path d=\"M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.335.104 11.896c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.444h.004c6.58 0 11.939-5.335 11.939-11.896 0-3.176-1.24-6.165-3.468-8.447zM12.047 21.782h-.004c-1.78 0-3.524-.476-5.05-1.378l-.36-.214-3.766.983.998-3.655-.235-.373c-1-1.583-1.528-3.413-1.528-5.275 0-5.464 4.453-9.904 9.924-9.904 2.653 0 5.145 1.028 7.02 2.893 1.875 1.866 2.906 4.35 2.906 6.993 0 5.464-4.453 9.904-9.924 9.904z\" />\n                </svg>\n                Ask WhatsApp\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>"
      replacement_content: "    <div className=\"fixed inset-0 z-[75] flex items-center justify-center p-4 bg-black/60\">\n      <div className=\"bg-white border border-black/20 max-w-2xl w-full p-6 md:p-8 relative shadow-2xl overflow-hidden max-h-[90vh] flex flex-col md:flex-row gap-6\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-3 right-3 z-10 text-black/50 hover:text-black p-1 transition-colors\"\n        >\n          <span className=\"material-symbols-outlined\">close</span>\n        </button>\n\n        {/* Product Image */}\n        <div className=\"w-full md:w-1/2 h-64 md:h-auto bg-[#F5F2ED] border border-black/10 p-4 flex items-center justify-center relative flex-shrink-0\">\n          <img\n            src={product.imageUrl}\n            alt={product.title}\n            className=\"max-h-full max-w-full object-contain mix-blend-multiply\"\n          />\n          {product.badge && (\n            <span className=\"absolute top-3 left-3 bg-[#1A1A1A] text-white font-bold text-[9px] uppercase tracking-[0.2em] px-2.5 py-1\">\n              {product.badge}\n            </span>\n          )}\n        </div>\n\n        {/* Details Content */}\n        <div className=\"w-full md:w-1/2 flex flex-col justify-between overflow-y-auto pr-1\">\n          <div>\n            <span className=\"text-[9px] font-bold uppercase tracking-[0.2em] text-[#b45309] block mb-1\">\n              {product.brand} \342\200\242 {product.category}\n            </span>\n            <h2 className=\"text-xl font-serif font-bold text-[#1A1A1A] mb-2 tracking-tight\">\n              {product.title}\n            </h2>\n\n            <div className=\"flex items-baseline gap-2 mb-3\">\n              <span className=\"text-2xl font-serif italic font-bold text-[#1A1A1A]\">\n                KSh {product.price.toLocaleString()}\n              </span>\n              {product.unit && (\n                <span className=\"text-xs text-black/50 font-normal\">\n                  {product.unit}\n                </span>\n              )}\n              {product.originalPrice && (\n                <span className=\"text-xs text-black/40 line-through\">\n                  KSh {product.originalPrice.toLocaleString()}\n                </span>\n              )}\n            </div>\n\n            <p className=\"text-xs text-black/70 leading-relaxed mb-4 font-sans\">\n              {product.description}\n            </p>\n\n            {/* Spec Sheet Table */}\n            <div className=\"mb-4\">\n              <h4 className=\"text-[10px] font-bold uppercase tracking-wider text-black/50 mb-2\">\n                Technical Specifications\n              </h4>\n              <ul className=\"spec-list text-xs text-[#1A1A1A] border border-black/10 overflow-hidden\">\n                {product.specs.map((spec, idx) => (\n                  <li key={idx} className=\"px-3 py-1.5 flex justify-between border-b border-black/5 last:border-none\">\n                    <span className=\"text-black/50\">{spec.label}</span>\n                    <span className=\"font-bold text-[#1A1A1A]\">{spec.value}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          <div className=\"space-y-3 pt-3 border-t border-black/10\">\n            {/* Quantity Selector */}\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[10px] uppercase font-bold tracking-wider text-black/60\">Quantity</span>\n              <div className=\"flex items-center border border-black/15 bg-white\">\n                <button\n                  onClick={() => setQuantity(Math.max(1, quantity - 1))}\n                  className=\"px-3 py-1 text-xs text-black/70 hover:bg-black/5\"\n                >\n                  -\n                </button>\n                <span className=\"px-3 py-1 text-xs font-bold text-[#1A1A1A]\">{quantity}</span>\n                <button\n                  onClick={() => setQuantity(quantity + 1)}\n                  className=\"px-3 py-1 text-xs text-black/70 hover:bg-black/5\"\n                >\n                  +\n                </button>\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleAdd}\n                className=\"flex-1 bg-[#1A1A1A] hover:bg-[#b45309] text-white font-bold py-3 px-4 text-[10px] tracking-[0.2em] uppercase flex justify-center items-center gap-1.5 transition-colors cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-sm\">add_shopping_cart</span>\n                {addedToast ? \'Added to Bag \342\234\223\' : \'Add to Bag\'}\n              </button>\n\n              <button\n                onClick={openWhatsAppInquiry}\n                className=\"py-3 px-3 border border-black/20 text-[#1A1A1A] hover:bg-black/5 font-bold text-[10px] tracking-[0.2em] uppercase flex items-center justify-center gap-1 transition-colors cursor-pointer\"\n                title=\"Inquire via WhatsApp\"\n              >\n                <svg className=\"w-4 h-4 fill-current text-green-700\" viewBox=\"0 0 24 24\">\n                  <path d=\"M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.335.104 11.896c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.444h.004c6.58 0 11.939-5.335 11.939-11.896 0-3.176-1.24-6.165-3.468-8.447zM12.047 21.782h-.004c-1.78 0-3.524-.476-5.05-1.378l-.36-.214-3.766.983.998-3.655-.235-.373c-1-1.583-1.528-3.413-1.528-5.275 0-5.464 4.453-9.904 9.924-9.904 2.653 0 5.145 1.028 7.02 2.893 1.875 1.866 2.906 4.35 2.906 6.993 0 5.464-4.453 9.904-9.924 9.904z\" />\n                </svg>\n                Inquire\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>"
