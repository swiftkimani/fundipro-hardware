    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { branches } from \'../data/portfolio\';\n\nexport const ContactView: React.FC = () => {\n  const [submitted, setSubmitted] = useState(false);\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    email: \'\',\n    subject: \'General Inquiry\',\n    message: \'\'\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n    setTimeout(() => {\n      setSubmitted(false);\n      setFormData({ name: \'\', phone: \'\', email: \'\', subject: \'General Inquiry\', message: \'\' });\n    }, 4000);\n  };\n\n  return (\n    <div className=\"w-full max-w-7xl mx-auto px-4 md:px-12 py-12\">\n      <div className=\"text-center max-w-2xl mx-auto mb-12\">\n        <span className=\"bg-[#f28c28] text-[#5d2f00] text-xs font-bold uppercase tracking-wider px-3 py-1 rounded\">\n          Get in Touch\n        </span>\n        <h1 className=\"text-3xl md:text-4xl font-extrabold font-headline text-[#914d00] mt-3 mb-4\">\n          Contact FundiPro Hardware\n        </h1>\n        <p className=\"text-sm text-[#554336] leading-relaxed\">\n          Need advice on building materials, power tool specifications, or current site delivery timelines? Our sales and technical staff are ready to help.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16\">\n        {/* Branch Info Cards */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <h2 className=\"text-xl font-bold font-headline text-[#1a1c1c] border-b border-[#dbc2b0] pb-2\">\n            Store Branches\n          </h2>\n\n          {branches.map((branch, index) => (\n            <div key={index} className=\"bg-white border border-[#dbc2b0] rounded-lg p-5 shadow-xs space-y-3\">\n              <h3 className=\"text-lg font-bold font-headline text-[#914d00]\">\n                {branch.name}\n              </h3>\n              <div className=\"text-xs text-[#554336] space-y-1.5\">\n                <p>\360\237\223\215 {branch.address}, {branch.city}</p>\n                <p>\360\237\223\236 Phone: <strong className=\"text-[#1a1c1c]\">{branch.phone}</strong></p>\n                <p>\342\234\211 Email: {branch.email}</p>\n                <p>\360\237\225\222 {branch.hours}</p>\n              </div>\n              <div className=\"pt-2 flex gap-2\">\n                <a\n                  href={`tel:${branch.phone}`}\n                  className=\"flex-1 bg-[#e8e8e8] hover:bg-[#dbc2b0] text-[#1a1c1c] text-xs font-bold py-2 rounded text-center transition-colors\"\n                >\n                  Call Branch\n                </a>\n                <a\n                  href={`https://wa.me/${branch.whatsapp}`}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"flex-1 bg-[#25D366] hover:bg-[#1EBE5C] text-white text-xs font-bold py-2 rounded text-center transition-colors\"\n                >\n                  WhatsApp\n                </a>\n              </div>\n            </div>\n          ))}\n\n          {/* Quick Support Badge */}\n          <div className=\"bg-[#ffdcc3] border border-[#f28c28]/40 rounded-lg p-5 text-xs text-[#5d2f00]\">\n            <h4 className=\"font-bold text-sm mb-1\">M-PESA &amp; ETR Receipt Support</h4>\n            <p className=\"leading-relaxed\">\n              Lipa na M-PESA Till No: <strong>522522</strong> | Account: <strong>FundiPro</strong>.\n              Automated KRA tax invoices issued with every order.\n            </p>\n          </div>\n        </div>\n\n        {/* Contact Form */}\n        <div className=\"lg:col-span-7 bg-white border border-[#dbc2b0] rounded-lg p-6 md:p-8 shadow-xs\">\n          <h2 className=\"text-xl font-bold font-headline text-[#1a1c1c] mb-6 border-b border-[#dbc2b0] pb-2\">\n            Send an Online Inquiry\n          </h2>\n\n          {submitted ? (\n            <div className=\"bg-green-50 border border-green-200 p-6 rounded-lg text-center space-y-2 my-8\">\n              <span className=\"material-symbols-outlined text-4xl text-green-600\">\n                check_circle\n              </span>\n              <h3 className=\"font-bold text-green-800 text-lg\">Message Sent Successfully</h3>\n              <p className=\"text-xs text-green-700\">\n                Thank you for contacting FundiPro Hardware. One of our sales team representatives will get back to you shortly.\n              </p>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                    Your Full Name *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. Peter Njoroge\"\n                    value={formData.name}\n                    onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                    className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                    Phone / WhatsApp Number *\n                  </label>\n                  <input\n                    type=\"tel\"\n                    required\n                    placeholder=\"0722 000 000\"\n                    value={formData.phone}\n                    onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                    className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                    Email Address\n                  </label>\n                  <input\n                    type=\"email\"\n                    placeholder=\"peter@example.com\"\n                    value={formData.email}\n                    onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                    className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                    Subject / Topic\n                  </label>\n                  <select\n                    value={formData.subject}\n                    onChange={(e) => setFormData({ ...formData, subject: e.target.value })}\n                    className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                  >\n                    <option>General Product Inquiry</option>\n                    <option>Price Quote / Bulk Discount</option>\n                    <option>Site Delivery Schedule</option>\n                    <option>Power Tool Warranty &amp; Service</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#1a1c1c] mb-1\">\n                  How can we help your project? *\n                </label>\n                <textarea\n                  required\n                  rows={4}\n                  placeholder=\"Describe the materials, tools, or delivery questions you have...\"\n                  value={formData.message}\n                  onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                  className=\"w-full border border-[#887364] rounded px-3 py-2 bg-white text-sm focus:outline-none focus:border-[#914d00]\"\n                ></textarea>\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full bg-[#f28c28] hover:bg-[#d97c23] text-[#5d2f00] font-bold py-3 px-6 rounded text-sm transition-colors shadow-xs\"\n              >\n                Send Message to FundiPro Sales\n              </button>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
