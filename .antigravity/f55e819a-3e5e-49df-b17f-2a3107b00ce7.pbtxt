      target_content: "    <footer className=\"w-full py-12 px-4 md:px-12 bg-[#2f3131] text-[#e2e2e2] border-t border-[#887364] mt-auto\">\n      <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8\">\n        <div className=\"max-w-md\">\n          <h2 className=\"text-2xl font-bold font-headline text-[#ffdcc3] mb-3\">\n            FundiPro Hardware\n          </h2>\n          <p className=\"text-sm mb-4 text-[#e2e2e2]/80 leading-relaxed\">\n            Supplying professional grade tools, power machinery, and building materials to the Kenyan construction industry since 2012. KEBS Certified and KRA ETR Compliant.\n          </p>\n          <div className=\"flex gap-3 text-xs text-[#ffdcc3]/90 font-medium\">\n            <span className=\"bg-[#5d2f00]/60 px-2.5 py-1 rounded border border-[#f28c28]/40\">\n              Nairobi: Enterprise Rd\n            </span>\n            <span className=\"bg-[#5d2f00]/60 px-2.5 py-1 rounded border border-[#f28c28]/40\">\n              Mombasa: Mbaraki Hub\n            </span>\n          </div>\n        </div>\n\n        <div className=\"flex flex-wrap gap-10 md:gap-16\">\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-[#ffdcc3] mb-1\">\n              Explore Products\n            </h3>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Power Tools\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Hand Tools - Fundi\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Building Materials\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Roofing (Mabati)\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-[#ffdcc3] mb-1\">\n              Quick Links\n            </h3>\n            <button\n              onClick={() => setActiveTab(\'portfolio\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Case Studies &amp; Portfolio\n            </button>\n            <button\n              onClick={() => setActiveTab(\'services\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Bulk Supply &amp; Site Delivery\n            </button>\n            <button\n              onClick={() => setActiveTab(\'contact\')}\n              className=\"text-left text-sm text-[#e2e2e2]/80 hover:text-[#ffdcc3] transition-colors\"\n            >\n              Branch Locations &amp; Support\n            </button>\n            <button\n              onClick={onRequestQuote}\n              className=\"text-left text-sm text-[#f28c28] hover:underline font-bold\"\n            >\n              Request Bulk Quote \342\206\222\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-[#ffdcc3] mb-1\">\n              Legal &amp; Compliance\n            </h3>\n            <span className=\"text-sm text-[#e2e2e2]/80\">Privacy Policy</span>\n            <span className=\"text-sm text-[#e2e2e2]/80\">Terms of Service</span>\n            <span className=\"text-sm text-[#e2e2e2]/80\">KRA ETR Invoicing</span>\n            <span className=\"text-sm text-[#e2e2e2]/80\">KEBS Standard Quality</span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto border-t border-gray-700 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-[#e2e2e2]/60 gap-4\">\n        <p>\302\251 2026 FundiPro Hardware Ltd. All Rights Reserved.</p>\n        <p className=\"flex items-center gap-2\">\n          <span className=\"w-2 h-2 rounded-full bg-green-500 inline-block\"></span>\n          Live Kenya Delivery Status: Operational\n        </p>\n      </div>\n    </footer>"
      replacement_content: "    <footer className=\"w-full py-12 px-4 md:px-12 bg-[#1A1A1A] text-white border-t border-black/20 mt-auto\">\n      <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8\">\n        <div className=\"max-w-md\">\n          <h2 className=\"text-2xl font-serif font-bold text-white mb-3 italic tracking-tight\">\n            FundiPro Hardware\n          </h2>\n          <p className=\"text-xs mb-4 text-white/70 leading-relaxed font-sans\">\n            Supplying professional grade tools, power machinery, and building materials to the Kenyan construction industry since 2012. KEBS Certified and KRA ETR Compliant.\n          </p>\n          <div className=\"flex gap-2 text-[9px] text-white/80 font-bold tracking-[0.2em] uppercase\">\n            <span className=\"bg-white/10 px-2.5 py-1 border border-white/10\">\n              Nairobi: Enterprise Rd\n            </span>\n            <span className=\"bg-white/10 px-2.5 py-1 border border-white/10\">\n              Mombasa: Mbaraki Hub\n            </span>\n          </div>\n        </div>\n\n        <div className=\"flex flex-wrap gap-10 md:gap-16\">\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#b45309] mb-1\">\n              Explore Products\n            </h3>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Power Tools\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Hand Tools - Fundi\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Building Materials\n            </button>\n            <button\n              onClick={() => setActiveTab(\'shop\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Roofing (Mabati)\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#b45309] mb-1\">\n              Quick Links\n            </h3>\n            <button\n              onClick={() => setActiveTab(\'portfolio\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Case Studies &amp; Portfolio\n            </button>\n            <button\n              onClick={() => setActiveTab(\'services\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Bulk Supply &amp; Site Delivery\n            </button>\n            <button\n              onClick={() => setActiveTab(\'contact\')}\n              className=\"text-left text-xs text-white/70 hover:text-white transition-colors cursor-pointer\"\n            >\n              Branch Locations &amp; Support\n            </button>\n            <button\n              onClick={onRequestQuote}\n              className=\"text-left text-xs text-[#b45309] hover:underline font-bold uppercase tracking-wider cursor-pointer\"\n            >\n              Request Bulk Quote \342\206\222\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2.5\">\n            <h3 className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#b45309] mb-1\">\n              Legal &amp; Compliance\n            </h3>\n            <span className=\"text-xs text-white/70\">Privacy Policy</span>\n            <span className=\"text-xs text-white/70\">Terms of Service</span>\n            <span className=\"text-xs text-white/70\">KRA ETR Invoicing</span>\n            <span className=\"text-xs text-white/70\">KEBS Standard Quality</span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center text-[11px] text-white/50 gap-4 font-sans\">\n        <p>\302\251 2026 FundiPro Hardware Ltd. All Rights Reserved.</p>\n        <p className=\"flex items-center gap-2\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse\"></span>\n          Live Kenya Delivery Status: Operational\n        </p>\n      </div>\n    </footer>"
